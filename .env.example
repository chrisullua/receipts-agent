# Proveedor del LLM: "anthropic" para usar Claude, "mock" para probar sin API key
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Base de datos (docker-compose la sobreescribe para el contenedor)
DATABASE_URL=postgresql://facturas:facturas@localhost:5432/facturas
POSTGRES_PASSWORD=facturas

# Debajo de esta confianza la factura queda marcada para revisión manual
UMBRAL_CONFIANZA=0.8

# Google Docs (opcional): ruta al JSON de una cuenta de servicio
GOOGLE_CREDENTIALS_FILE=
# Email con el que se comparte el informe generado
GOOGLE_SHARE_WITH=
